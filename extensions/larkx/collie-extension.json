{
  "manifest_version": 1,
  "id": "larkx",
  "label": "飞书",
  "name": "飞书（以你本人身份）",
  "version": "0.4.16",
  "icon": "icon.png",
  "description": "用你自己的飞书账号和 agent 对话：扫码登录后，飞书会话出现在收件箱。你在任意会话里发一条以触发词开头的消息，Collie 先给它点个「在做了」，做完以你的名义回复，格式照常显示，末尾带一段尾标。",
  "warning": "用的是飞书网页版接口，飞书升级后可能失效；登录状态只存在运行它的那台电脑上；用公司账号前先确认公司规定。",
  "homepage": "https://github.com/cv-cat/LarkAgentX",
  "engines": {
    "collie_protocol": 1
  },
  "runtime": {
    "command": "bin/larkx"
  },
  "source": {
    "base": "https://raw.githubusercontent.com/cv-cat/LarkAgentX/97ad48e69e34bd8c78ee30f795b7c3759dd81659/",
    "files": {
      "larkx/auth.py": "8bdfd3804b1c2e7c3dca29e2bd1a48be7e1b9b3322ceb7564deb3d107186716a",
      "larkx/client.py": "d81267309c7211d64b55410fcb8bb7f5e1a4836db556f02e44e658dfd7b853b6",
      "larkx/config.py": "6a2a5abd661cdd33f18fa9fa2e4e38933ce298757eb827cdd8433d44004d0461",
      "larkx/media.py": "e6def0c0bbb7a8fa363eeb2f7ad3928c35e51e71d12e7a93b4b8d2119b0a9db5",
      "larkx/proto/__init__.py": "728c212ff2cad359d40cc084655207839dfd09fa2a1ba0bc7231ececebd97d7c",
      "larkx/proto/builders.py": "a81f5c8066f3648b98004b1aad13f404652067e0c2972e036ab1f3ae06c2c92b",
      "larkx/proto/cmd_map.json": "f51047047c949f02e6434b73bab98cb7063d57a20e53e3d062c305258fb1ea8d",
      "larkx/proto/decoders.py": "57fbd2c9a25993d79aa8476995e2eb77ba3f9399eb5d7b6032ffd71c82f744f8",
      "larkx/proto/gateway.py": "c5a58b4defb3585a7cd146ad81a8d52af8be20ac7842deed30fef6b0822aad82",
      "larkx/proto/ids.py": "dbb6a57e0d0beecb6016fa8083a5dc9f5ccd1933f66d03313750a48945d22f64",
      "larkx/proto/lark_all_pb2.py": "a725f6695444c0efbd7fa9aa9b559fa7cb0e8832cab886173d8e3741e0fc1f5a",
      "larkx/proto/proto_pb2.py": "0f2692f3e62d6a7a8e2dbca3814e891fe9889a4badd067c7dd35cb4b796816d7",
      "larkx/region.py": "a9072f00d9e5c1614aa4c522cfe92e7068413d86773a6f08e312c241bb6ceb35"
    }
  },
  "requires": [
    "python3"
  ],
  "contributes": {
    "connector": {
      "id": "larkx",
      "login": "qr",
      "capabilities": [
        "status",
        "login",
        "receive",
        "send",
        "working",
        "read",
        "inbox_recent"
      ]
    },
    "channel": {
      "format": "markdown",
      "max_text": 4000,
      "kinds": [
        "answer",
        "progress",
        "result",
        "push"
      ]
    }
  },
  "configuration": {
    "type": "object",
    "properties": {
      "region": {
        "type": "string",
        "title": "站点",
        "description": "换站点要重新扫码，原来的登录只在原站点有效。",
        "default": "feishu",
        "enum": [
          "feishu",
          "lark"
        ],
        "x-labels": [
          "飞书",
          "Lark（国际版）"
        ]
      },
      "self_mention": {
        "type": "boolean",
        "title": "@自己唤起",
        "description": "你在消息里 @ 自己，也算唤起 agent。",
        "default": true
      },
      "group_topics": {
        "type": "boolean",
        "title": "群话题各开对话",
        "description": "群里每个话题各用一段对话。",
        "default": true
      },
      "read_back": {
        "type": "boolean",
        "title": "在 Collie 里读过的同步为飞书已读",
        "description": "在收件箱里打开会话、点「全部已读」时，也在飞书里标为已读。会改你在飞书上的未读状态；话题群不同步。",
        "default": false,
        "x-read-back": true
      },
      "hide_muted": {
        "type": "boolean",
        "title": "免打扰的会话不显示",
        "description": "关掉后照样显示，未读数是灰色，也不提醒。",
        "default": true,
        "x-hide": "muted"
      },
      "hide_meego_story": {
        "type": "boolean",
        "title": "Meego 需求同步群不显示",
        "description": "Meego 为需求建的群：群描述是需求链接，群名带「[需求同步群]」。群名太长被截短时也认得出。",
        "default": true,
        "x-hide": [
          "tag:meego-story",
          "name:[需求同步群]"
        ]
      },
      "hide_meego_bug": {
        "type": "boolean",
        "title": "Meego 缺陷同步群不显示",
        "description": "Meego 为缺陷建的群：群描述是缺陷链接，群名带「[缺陷同步群]」。群名太长被截短时也认得出。",
        "default": true,
        "x-hide": [
          "tag:meego-issue",
          "name:[缺陷同步群]"
        ]
      }
    }
  },
  "permissions": {
    "network": [
      "*.feishu.cn",
      "*.larksuite.com",
      "*.feishucdn.com",
      "raw.githubusercontent.com",
      "pypi.org",
      "files.pythonhosted.org"
    ]
  },
  "defaults": {
    "machine": "router",
    "handler": "agent",
    "conversations": "off"
  }
}
