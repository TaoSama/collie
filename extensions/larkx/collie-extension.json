    }
  },
  "requires": ["python3"],
  "contributes": {
    "connector": {"id": "larkx", "login": "qr", "capabilities": ["status", "login", "archive", "actions"], "send_action": "larkx_send"},
    "channel": {"format": "markdown", "max_text": 4000, "kinds": ["answer", "result", "push"]}
  },
  "configuration": {
    "type": "object",
    "properties": {
      "region": {"type": "string", "title": "站点", "description": "改了要重新扫码：登录凭据只对所属站点有效。", "default": "feishu", "enum": ["feishu", "lark"], "x-labels": ["飞书", "Lark（国际版）"]}
    }
  },
  "permissions": {"network": ["*.feishu.cn", "*.larksuite.com", "*.larkoffice.com", "raw.githubusercontent.com", "codeload.github.com", "pypi.org", "files.pythonhosted.org"]},
  "defaults": {"machine": "router", "handler": "agent", "conversations": "off"}
}
