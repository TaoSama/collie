{
  "manifest_version": 1,
  "id": "larkx",
  "label": "飞书",
  "name": "飞书（以你本人身份）",
  "version": "0.3.6",
  "description": "用 LarkAgentX 扫码登录飞书网页版，以你本人的身份收发消息。收件箱列出你的飞书会话，打开某个会话后，发触发词即可交给 agent，回复以你的身份发出并带上尾标。",
  "warning": "走逆向的飞书网页版协议，不是官方接口：飞书升级后可能失效，账号可能被风控。登录凭据是完整的网页会话，只保存在运行它的那台电脑上。公司账号请先确认公司规定。",
  "homepage": "https://github.com/cv-cat/LarkAgentX",
  "engines": {"collie_protocol": 1},
  "runtime": {"command": "bin/larkx"},
  "source": {
    "base": "https://raw.githubusercontent.com/nwverse/persona-extensions/443ac2675448fb0f904bb78d49f951595b131b3a/extensions/larkx/",
    "files": {
      "README.md": "f59c2ef0b7d7e99f4f382b3fd7640caa2d676718dc492562bc12c600cb0afc35",
      "assets/LICENSE": "401f92d98473d65a34d3b4458ece98ea4f56ee3ec1fb5cc29815e440895798c1",
      "assets/icon.png": "50fd95485ea08de428ca0c1e61133dbe8a23580f8b09c1ceba721d1d4a26b330",
      "assistant/instructions.md": "62a22204ca9237bb52328212a489c13b7988f35a6839410eb00e91154eebf6b8",
      "bin/larkx": "2b9ec5c5341d88840fb577ff6dbae18381d6bcda7e96efdb5c55759adaf00b6a",
      "persona-extension.json": "b376c372950129dd67dd25f1d7f1b5f459de4da11a11f993e3508e90deb43edd",
      "requirements.txt": "16bc7d057205d938b46a6cf34bb42388d4d1149e5dd236da30c41cefa1f57e92",
      "src/larkx_persona/__init__.py": "36f02647a7b1290758c5ad98c043d9d5a6a79b74b2e3716f3e36bf5aa5d4d044",
      "src/larkx_persona/connector.py": "7eb7166fe060ef45d072bf33d7adc25fa3a5c6c417559c6e771e42933ce937df",
