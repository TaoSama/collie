#!/bin/sh
# Starts the adapter with the first python3 that is 3.9 or newer.
dir=$(cd "$(dirname "$0")/.." && pwd)
for py in python3 python3.13 python3.12 python3.11 python3.10 python3.9; do
	if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
		exec "$py" -I "$dir/adapter/main.py"
	fi
done
echo "larkx needs Python 3.9 or newer (python3)" >&2
exit 1
